/vendor/
/node_modules/
/dist/
/build/
/coverage/

# Environment files
.env
.env.backup
.env.production
!.env.example

# Laravel storage & cache
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore

# SQLite databases
/database/*.sqlite
/database/*.sqlite-journal

# Logs & OS metadata
*.log
.DS_Store
Thumbs.db

.phpunit.result.cache

# Cache bootstrap Laravel (dibuat ulang otomatis)
/bootstrap/cache/*.php

# Database SQLite lokal / hasil uji
/siuba_db

# File password awal hasil seeder
/storage/app/initial-admin-password.txt
# Berkas backup database tidak boleh ikut ke repositori / paket update
/storage/app/backups/
/storage/app/*.sql
